          {
            "type": "string",
            "description": "조회 시작 시간 (RFC3339)",
            "name": "since",
            "in": "query",
            "required": true
          },
          {
            "type": "integer",
            "default": 50,
            "description": "최대 개수",
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/models.NotificationWithStatus"
              }
            }
          },
          "400": {
            "description": "Bad Request",
