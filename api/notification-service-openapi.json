    "/notification/api/v1/popup-rules": {
      "get": {
        "description": "소프트 삭제되지 않은 팝업 규칙을 priority 내림차순, name 오름차순으로 반환합니다. settings:write 미보유 주체에게는 target_usernames·created_by·updated_by 를 생략하고 target_username_count 와 target_usernames_redacted=true 만 내려줍니다",
        "produces": [
          "application/json"
        ],
        "tags": [
          "popup-rules"
        ],
        "summary": "팝업 규칙 목록 조회",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/handler.PopupRuleListResponse"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "post": {
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "popup-rules"
        ],
        "summary": "팝업 규칙 생성",
        "parameters": [
          {
            "description": "규칙",
            "name": "rule",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/models.PopupRuleInput"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/handler.PopupRuleResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "409": {
            "description": "Conflict",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "/notification/api/v1/popup-rules/{id}": {
      "get": {
        "description": "settings:write 미보유 주체에게는 target_usernames·created_by·updated_by 를 생략합니다(목록과 동일 규칙)",
        "produces": [
          "application/json"
        ],
        "tags": [
          "popup-rules"
        ],
        "summary": "팝업 규칙 단건 조회",
        "parameters": [
          {
            "type": "string",
            "description": "규칙 ID",
            "name": "id",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/handler.PopupRuleResponse"
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "put": {
        "description": "전체 치환. 바디의 updated_at(선택, GET 응답값 그대로)이 현재 행과 다르면 409 POPUP_RULE_STALE 로 거절합니다(동시 편집 보호)",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "popup-rules"
        ],
        "summary": "팝업 규칙 수정",
        "parameters": [
          {
            "type": "string",
            "description": "규칙 ID",
            "name": "id",
            "in": "path",
            "required": true
          },
          {
            "description": "규칙",
            "name": "rule",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/models.PopupRuleInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/handler.PopupRuleResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "409": {
            "description": "POPUP_RULE_NAME_CONFLICT(field=name) 또는 POPUP_RULE_STALE(field=updated_at)",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "delete": {
        "produces": [
          "application/json"
        ],
        "tags": [
          "popup-rules"
        ],
        "summary": "팝업 규칙 삭제",
        "parameters": [
          {
            "type": "string",
            "description": "규칙 ID",
            "name": "id",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "204": {
            "description": "삭제됨"
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "patch": {
        "description": "목록 화면의 토글 전용. 바디 {\"enabled\": bool} 만 반영하고 다른 필드는 무시합니다. 전체 규칙을 돌려줍니다",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "popup-rules"
        ],
        "summary": "팝업 규칙 활성 여부 변경",
        "parameters": [
          {
            "type": "string",
            "description": "규칙 ID",
            "name": "id",
            "in": "path",
            "required": true
          },
          {
            "description": "활성 여부",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/handler.popupRuleEnabledPatch"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/handler.PopupRuleResponse"
            }
          },
          "400": {
            "description": "POPUP_RULE_INVALID(field=enabled)",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "/notification/api/v1/popup-rules/{id}/test": {
      "post": {
        "description": "규칙 조건과 무관하게 합성 이벤트를 발행해 \"이 규칙이 누구에게 어떻게 팝업되는지\" 를 즉시 확인합니다. 알림은 DB에 저장되지 않습니다.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "popup-rules"
        ],
        "summary": "팝업 규칙 테스트 전송",
        "parameters": [
          {
            "type": "string",
            "description": "규칙 ID",
            "name": "id",
            "in": "path",
            "required": true
          },
          {
            "description": "카메라·채널·심각도 재정의(생략 시 규칙 값 사용. channel_id 는 다채널 카메라에서 팝업이 열 채널 — 생략하면 프론트가 첫 채널을 연다)",
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/handler.PopupRuleTestRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/handler.PopupRuleTestResponse"
            }
          },
          "400": {
            "description": "POPUP_RULE_INVALID / POPUP_RULE_TEST_CAMERA_REQUIRED",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "404": {
            "description": "POPUP_RULE_NOT_FOUND",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "422": {
            "description": "POPUP_RULE_TEST_NO_RECIPIENT",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "429": {
            "description": "POPUP_RULE_TEST_RATE_LIMITED",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "503": {
            "description": "POPUP_RULE_TEST_TARGETS_UNRESOLVED",
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "handler.PopupRuleListResponse": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/handler.PopupRuleResponse"
          }
        }
      }
    },
    "handler.PopupRuleResponse": {
      "type": "object",
      "properties": {
        "camera_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "close_on_clear": {
          "description": "CloseOnClear 같은 카메라·유형의 해제 이벤트(state=false) 수신 시 팝업 자동 닫기.",
          "type": "boolean"
        },
        "cooldown_sec": {
          "type": "integer"
        },
        "created_at": {
          "type": "string"
        },
        "created_by": {
          "description": "CreatedBy 생성자 계정명. 가림 시 키 생략(대상 사용자 목록과 같은 \"계정명 원문\" 이다).",
          "type": "string"
        },
        "duration_sec": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "engine_rule_names": {
          "description": "---- O-18 룰 엔진 결합 ----\nEngineRuleNames 룰 엔진(event-engine-service) 룰 이름 목록(최대 32, 대소문자 구분 정확 일치).\n비면 종전대로 event_types 축으로 매칭한다. 비어 있지 않으면 알림의 data.popup_hint.rule_name 이\n이 목록에 있을 때만 매칭하고 **event_types 축은 평가하지 않는다**(계약 §4.1 — 한 규칙은\n\"이벤트 유형 기반\" 또는 \"룰 이름 기반\" 둘 중 하나로만 동작). 힌트가 없는 알림은 매칭되지 않는다.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "event_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "linked_camera_ids": {
          "description": "LinkedCameraIDs 팝업에 함께 띄울 연결 카메라(최대 3). 소스 카메라와 같은 id 는 지시에서 제거된다.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min_severity": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "playback_offset_sec": {
          "description": "PlaybackOffsetSec 0 = 라이브, N(10..300) = 이벤트 N초 전부터 재생.",
          "type": "integer",
          "example": 0
        },
        "priority": {
          "type": "integer"
        },
        "require_ack": {
          "description": "RequireAck 자동 닫힘 없음 — 확인(ack)으로만 종료. true 면 지시의 duration_sec 는 0 으로 나간다.",
          "type": "boolean"
        },
        "schedule": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/models.PopupRuleSchedule"
          }
        },
        "sound": {
          "description": "---- 2단계(O-17) ----\nSound 팝업 시 재생할 내장 사운드(none|default|chime|siren). none = 무음.",
          "type": "string",
          "enum": [
            "none",
            "default",
            "chime",
            "siren"
          ],
          "example": "default"
        },
        "sound_repeat": {
          "description": "SoundRepeat 확인 전까지 반복 재생. require_ack=true 이고 sound!=none 일 때만 true.",
          "type": "boolean"
        },
        "stream": {
          "type": "string"
        },
        "target_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_username_count": {
          "description": "TargetUsernameCount 대상 사용자 수. 권한과 무관하게 **항상** 싣는다.\n가림 상태에서도 \"몇 명에게 뜨는 규칙인가\" 는 운영 판단에 필요하고, 계정명은 새지 않는다.",
          "type": "integer"
        },
        "target_usernames": {
          "description": "TargetUsernames 대상 사용자 계정명 목록. 가림 시 nil → 키 자체가 없다.\n원문을 줄 때는 nil 을 빈 배열로 정규화해 JSON null 이 나가지 않게 한다.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
